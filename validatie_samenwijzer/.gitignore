.env
data/*
# skills-taxonomie-artefact is klein + ESCO-afgeleid (CC BY) → wel tracken, zodat
# de gecureerde matches in de repo zitten en op elke machine werken (geen rebuild nodig).
!data/skills/
# crebo→naam-lookup voor de opleidingskiezer: klein, deterministisch, afgeleid uit
# kwalificatiedossiers/crebolijst.xlsx → tracken zodat de Fly-image 'm bevat (geen rebuild).
!data/opleidingsnamen.json
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/
.superpowers/
oeren/
*:Zone.Identifier
.uv_cache/

# Claude Code lokale/runtime-bestanden (niet versiebeheren)
.claude/
